# Server
PORT=4000
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_secret

# PostgreSQL
DATABASE_URL=postgres://civicfix:civicfix@localhost:5432/civicfix
PGSSL=false

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# CORS
FRONTEND_ORIGIN=http://localhost:5173
DASHBOARD_ORIGIN=http://localhost:5174

# Duplicate detection radius (meters) and time window (hours)
DUPLICATE_RADIUS_METERS=40
DUPLICATE_WINDOW_HOURS=72

# Seed municipal admin (created on first migrate if not present)
SEED_ADMIN_EMAIL=admin@civicfix.local
SEED_ADMIN_PASSWORD=change_me_now
